+				rcs |= wrapTGLReadAUX(port, 0x720, pre[1], 16) ? 2U : 0U;
+				uint8_t tcon[16] {};
+				rcs |= wrapTGLReadAUX(port, 0x340, tcon, 16) ? 4U : 0U;
+				const uint8_t cap2 = pre[0][2], b720 = pre[1][0], b721 = pre[1][1];
